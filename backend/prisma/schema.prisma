datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ENGINEER
  HOUSE_HOLDER
  MANAGER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum RequisitionType {
  PAYMENT
  MATERIAL
  AGREEMENT
  TECHNICAL_DOCUMENT
  VARIATION
  OTHER
}

enum RequisitionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REVISION_REQUIRED
  REJECTED
  PROCESSING
  DONE
  COMPLETED
}

enum ApprovalDecision {
  APPROVED
  REVISION_REQUIRED
  REJECTED
  UNDER_REVIEW
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
}

enum DeliveryStatus {
  PENDING
  ORDERED
  DELIVERED
}

model Company {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(255)
  code        String         @unique @db.VarChar(100)
  subdomain   String?        @unique @db.VarChar(100)
  logoUrl     String?        @map("logo_url") @db.VarChar(255)
  status      CompanyStatus  @default(ACTIVE)
  email       String?        @db.VarChar(255)
  phone       String?        @db.VarChar(50)
  address     String?        @db.Text
  totalSites  Int            @default(0) @map("total_sites")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  projects            Project[]
  sites               Site[]
  projectAssignments ProjectAssignment[]
  requisitions        Requisition[]
  requisitionMaterials RequisitionMaterial[]
  approvals           Approval[]
  payments            Payment[]
  expenses            Expense[]
  documents           Document[]
  auditLogs           AuditLog[]

  @@map("companies")
}

model User {
  id                   String      @id @default(uuid()) @db.Uuid
  companyId            String?     @map("company_id") @db.Uuid
  name                 String      @db.VarChar(255)
  email                String      @unique @db.VarChar(255)
  passwordHash         String      @map("password_hash") @db.VarChar(255)
  role                 UserRole    @default(ENGINEER)
  phone                String?     @db.VarChar(50)
  title                String?     @db.VarChar(255)
  status               String      @default("ACTIVE") @db.VarChar(50)
  resetPasswordToken   String?     @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires DateTime?   @map("reset_password_expires") @db.Timestamptz
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company              Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Project role relations
  houseHolderProjects  Project[]   @relation("HouseHolderProjects")
  engineerProjects     Project[]   @relation("EngineerProjects")
  managerProjects      Project[]   @relation("ManagerProjects")

  projectAssignments   ProjectAssignment[]
  submittedRequisitions Requisition[]       @relation("SubmittedBy")
  materialRequests     RequisitionMaterial[] @relation("MaterialRequestedBy")
  approvalsGiven       Approval[]          @relation("Approver")
  expensesRecorded     Expense[]           @relation("ExpenseRecorder")
  documentsUploaded    Document[]          @relation("UploadedBy")
  auditLogs            AuditLog[]

  @@map("users")
}

model Project {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  name               String         @db.VarChar(255)
  code               String?        @db.VarChar(100)
  location           String         @db.VarChar(255)
  houseHolderId      String?        @map("house_holder_id") @db.Uuid
  engineerId         String?        @map("engineer_id") @db.Uuid
  managerId          String?        @map("manager_id") @db.Uuid
  status             ProjectStatus  @default(ACTIVE)
  progress           Int            @default(0)
  totalBudget        Decimal        @default(0.00) @map("total_budget") @db.Decimal(15, 2)
  spentBudget        Decimal        @default(0.00) @map("spent_budget") @db.Decimal(15, 2)
  startDate          DateTime       @map("start_date") @db.Date
  expectedCompletion DateTime       @map("expected_completion") @db.Date
  description        String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  houseHolder        User?          @relation("HouseHolderProjects", fields: [houseHolderId], references: [id], onDelete: SetNull)
  engineer           User?          @relation("EngineerProjects", fields: [engineerId], references: [id], onDelete: SetNull)
  manager            User?          @relation("ManagerProjects", fields: [managerId], references: [id], onDelete: SetNull)

  sites              Site[]
  projectAssignments ProjectAssignment[]
  requisitions       Requisition[]
  requisitionMaterials RequisitionMaterial[]
  payments           Payment[]
  expenses           Expense[]
  documents          Document[]

  @@map("projects")
}

model Site {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String    @db.VarChar(255)
  location    String    @db.VarChar(255)
  details     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("sites")
}

model ProjectAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       UserRole
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_assignments")
}

model Requisition {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  type          RequisitionType   @default(PAYMENT)
  title         String            @db.VarChar(255)
  amount        Decimal           @default(0.00) @db.Decimal(15, 2)
  description   String            @db.Text
  submittedById String            @map("submitted_by") @db.Uuid
  status        RequisitionStatus @default(SUBMITTED)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy   User              @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  materials     RequisitionMaterial[]
  approvals     Approval[]
  payments      Payment[]

  @@map("requests")
}

model RequisitionMaterial {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  requisitionId  String?        @map("request_id") @db.Uuid
  materialName   String         @map("material_name") @db.VarChar(255)
  description    String?        @db.Text
  quantity       Decimal        @db.Decimal(10, 2)
  unit           String         @db.VarChar(50)
  estimatedCost  Decimal        @map("estimated_cost") @db.Decimal(15, 2)
  requestedById  String         @map("requested_by") @db.Uuid
  approvalStatus String         @default("Pending") @map("approval_status") @db.VarChar(50)
  deliveryStatus DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryDate   DateTime?      @map("delivery_date") @db.Date
  waybillDocUrl  String?        @map("waybill_doc_url") @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requisition    Requisition?   @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  requestedBy    User           @relation("MaterialRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@map("materials")
}

model Approval {
  id            String           @id @default(uuid()) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  requisitionId String           @map("request_id") @db.Uuid
  approverId    String           @map("author_id") @db.Uuid
  decision      ApprovalDecision @default(APPROVED)
  comment       String           @map("comment_text") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requisition   Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver      User             @relation("Approver", fields: [approverId], references: [id], onDelete: Restrict)

  @@map("request_comments")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  projectId          String        @map("project_id") @db.Uuid
  requisitionId      String?       @map("request_id") @db.Uuid
  requestedAmount    Decimal       @map("requested_amount") @db.Decimal(15, 2)
  approvedAmount     Decimal       @map("approved_amount") @db.Decimal(15, 2)
  additionalExpenses Decimal       @default(0.00) @map("additional_expenses") @db.Decimal(15, 2)
  totalAmount        Decimal       @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  status             PaymentStatus @default(PENDING)
  bankName           String?       @map("bank_name") @db.VarChar(150)
  paymentMethod      String?       @map("payment_method") @db.VarChar(100)
  paymentReference   String?       @map("payment_reference") @db.VarChar(150)
  receiptDocUrl      String?       @map("receipt_doc_url") @db.VarChar(255)
  paymentDate        DateTime?     @map("payment_date") @db.Date
  notes              String?       @db.Text
  expensesNotes      String?       @map("expenses_notes") @db.Text
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requisition        Requisition?  @relation(fields: [requisitionId], references: [id], onDelete: SetNull)

  expenses           Expense[]

  @@map("payments")
}

model Expense {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  paymentId    String?   @map("payment_id") @db.Uuid
  category     String    @db.VarChar(100) // e.g., Transport, Logistics, Labor, Fuel
  amount       Decimal   @db.Decimal(15, 2)
  description  String?   @db.Text
  recordedById String    @map("recorded_by") @db.Uuid
  expenseDate  DateTime  @default(now()) @map("expense_date") @db.Date
  receiptUrl   String?   @map("receipt_url") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  recordedBy   User      @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@map("expenses")
}

model Document {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  name         String    @db.VarChar(255)
  type         String    @db.VarChar(100)
  fileType     String    @map("file_type") @db.VarChar(50)
  fileSize     String    @map("file_size") @db.VarChar(50)
  fileUrl      String    @map("file_url") @db.VarChar(255)
  uploadedById String    @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
